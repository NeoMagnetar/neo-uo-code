+        private void UmgSleeve_MouseDoubleClickEvent(
+            object sender,
+            MouseDoubleClickEventArgs args
+        )
+        {
+            if (args.Button != MouseButtonType.Left)
+            {
+                return;
+            }
+
+            if (!HasAIGMCompanionBackpackMarker())
+            {
+                RefreshUmgSleevePic();
+
+                return;
+            }
+
+            GameActions.Say($"[umgsleeve 0x{LocalSerial:X8}");
+            args.Result = true;
+        }
+
+        private void RefreshUmgSleevePic()
+        {
+            if (!HasAIGMCompanionBackpackMarker())
+            {
+                RemoveUmgSleevePic();
+
+                return;
+            }
+
+            if (_umgSleevePic != null && !_umgSleevePic.IsDisposed)
+            {
+                _umgSleevePic.IsVisible = !IsMinimized;
+
+                return;
+            }
+
+            RemoveUmgSleevePic();
+
+            _umgSleevePic = new GumpPic(
+                NonPlayerProfileScrollX + PaperdollScrollSpacing,
+                PaperdollScrollY,
+                UMGScrollGraphic,
+                0
+            )
+            {
+                IsVisible = !IsMinimized
+            };
+
+            _umgSleevePic.SetTooltip("UMG Sleeve");
+            _umgSleevePic.MouseDoubleClick += UmgSleeve_MouseDoubleClickEvent;
+
+            Add(_umgSleevePic);
+        }
+
+        private void RemoveUmgSleevePic()
+        {
+            if (_umgSleevePic == null)
+            {
+                return;
+            }
+
+            _umgSleevePic.MouseDoubleClick -= UmgSleeve_MouseDoubleClickEvent;
+            Remove(_umgSleevePic);
+            _umgSleevePic.Dispose();
+            _umgSleevePic = null;
+        }
+
+        private bool HasAIGMCompanionBackpackMarker()
+        {
+            if (World.Player != null && LocalSerial == World.Player.Serial)
+            {
+                return false;
+            }
+
+            Mobile mobile = World.Mobiles.Get(LocalSerial);
+
+            if (mobile == null || mobile.IsDestroyed)
+            {
+                return false;
+            }
+
+            Item backpack = mobile.FindItemByLayer(Layer.Backpack);
+
+            return backpack != null
+                && !backpack.IsDestroyed
+                && IsAIGMCompanionBackpackGraphic(backpack)
+                && NormalizeHue(backpack.Hue) == AIGMCompanionBackpackHue;
+        }
+
+        private static bool IsAIGMCompanionBackpackGraphic(Item item)
+        {
+            return item.Graphic == AIGMCompanionBackpackGraphic
+                || item.DisplayedGraphic == AIGMCompanionBackpackGraphic;
+        }
+
+        private static ushort NormalizeHue(ushort hue)
+        {
+            return (ushort)(hue & 0x3FFF);
+        }
